[
    {
        "id": "wx_tab_01",
        "type": "tab",
        "label": "Gorakhpur Weather Monitoring",
        "disabled": false,
        "info": "IoT Weather Monitoring Solution for Gorakhpur - MMMUT Project\nParameters: Temperature, Humidity, Pressure, Wind Speed, Rainfall, UV Index"
    },

    {
        "id": "wx_inject_01",
        "type": "inject",
        "z": "wx_tab_01",
        "name": "Simulate Reading (every 5s)",
        "props": [{ "p": "payload" }],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": 1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 190,
        "y": 80,
        "wires": [["wx_func_gen"]]
    },

    {
        "id": "wx_func_gen",
        "type": "function",
        "z": "wx_tab_01",
        "name": "Generate Weather Data",
        "func": "// Simulated sensor readings for Gorakhpur, UP\n// Replace this block with real sensor read code (DHT22, BMP280, anemometer, rain gauge, UV sensor)\nvar now = new Date();\n\nvar temperature = +(25 + Math.random() * 15).toFixed(1);   // 25-40 C\nvar humidity    = +(40 + Math.random() * 50).toFixed(1);   // 40-90 %\nvar pressure    = +(1000 + Math.random() * 15).toFixed(1); // 1000-1015 hPa\nvar windSpeed   = +(Math.random() * 20).toFixed(1);        // 0-20 km/h\nvar rainfall    = +(Math.random() * 10).toFixed(1);        // 0-10 mm\nvar uvIndex     = +(Math.random() * 11).toFixed(1);        // 0-11\n\nmsg.payload = {\n    location: \"Gorakhpur\",\n    temperature: temperature,\n    humidity: humidity,\n    pressure: pressure,\n    windSpeed: windSpeed,\n    rainfall: rainfall,\n    uvIndex: uvIndex,\n    timestamp: now.toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 80,
        "wires": [["wx_mqtt_out", "wx_debug_01"]]
    },

    {
        "id": "wx_debug_01",
        "type": "debug",
        "z": "wx_tab_01",
        "name": "Sensor Data Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 690,
        "y": 140,
        "wires": []
    },

    {
        "id": "wx_mqtt_out",
        "type": "mqtt out",
        "z": "wx_tab_01",
        "name": "Publish Weather Data",
        "topic": "gorakhpur/weather/data",
        "qos": "0",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "wx_broker_01",
        "x": 690,
        "y": 80,
        "wires": []
    },

    {
        "id": "wx_broker_01",
        "type": "mqtt-broker",
        "name": "Mosquitto Local",
        "broker": "localhost",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "userProps": "",
        "sessionExpiry": ""
    },

    {
        "id": "wx_mqtt_in",
        "type": "mqtt in",
        "z": "wx_tab_01",
        "name": "Subscribe Weather Data",
        "topic": "gorakhpur/weather/data",
        "qos": "0",
        "datatype": "json",
        "broker": "wx_broker_01",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 190,
        "y": 240,
        "wires": [["wx_func_parse"]]
    },

    {
        "id": "wx_func_parse",
        "type": "function",
        "z": "wx_tab_01",
        "name": "Parse & Route to Dashboard",
        "func": "var data = msg.payload;\n\nvar temp = { payload: data.temperature };\nvar hum  = { payload: data.humidity };\nvar pres = { payload: data.pressure };\nvar wind = { payload: data.windSpeed };\nvar rain = { payload: data.rainfall };\nvar uv   = { payload: data.uvIndex };\n\nreturn [temp, hum, pres, wind, rain, uv];",
        "outputs": 6,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 240,
        "wires": [
            ["wx_gauge_temp", "wx_chart_temp"],
            ["wx_gauge_hum", "wx_chart_hum"],
            ["wx_gauge_pres"],
            ["wx_gauge_wind"],
            ["wx_gauge_rain"],
            ["wx_gauge_uv"]
        ]
    },

